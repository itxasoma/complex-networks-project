#!/bin/bash
#SBATCH --job-name=sis_part2
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
#SBATCH --time=24:00:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G

set -euo pipefail

module load gcc || true

mkdir -p logs results

gfortran -O3 -std=f2008 -Wall -Wextra -o sis_lifespan_cm sis_lifespan_cm.f90

N=${1:-100000}
GAMMA=${2:-3.5}
NRUNS=${3:-2000}
LMIN=${4:-0.02}
LMAX=${5:-0.10}
NLAM=${6:-25}

OUT="results/part2_N${N}_g${GAMMA}.dat"

./sis_lifespan_cm "$N" "$GAMMA" "$NRUNS" "$LMIN" "$LMAX" "$NLAM" "$OUT"