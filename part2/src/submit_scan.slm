#!/bin/bash
#SBATCH --job-name=part2_scan
#SBATCH --output=part2_scan_%j.out
#SBATCH --error=part2_scan_%j.err
#SBATCH --time=24:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G

set -euo pipefail

# Single-file cluster launcher for Part 2.
# Put this file in part2/src/submit_scan.slm and submit from the repo root with:
#   sbatch part2/src/submit_scan.slm
#
# Optional overrides when submitting:
#   sbatch --export=ALL,NRUNS=5000 part2/src/submit_scan.slm
#   sbatch --export=ALL,ONLY_GAMMA=3.5 part2/src/submit_scan.slm
#   sbatch --export=ALL,ONLY_N=1000000 part2/src/submit_scan.slm
#   sbatch --export=ALL,LMIN_35=0.05,LMAX_35=0.20 part2/src/submit_scan.slm

cd "$SLURM_SUBMIT_DIR"

if [ ! -f Makefile ]; then
  echo "ERROR: submit this job from the repository root"
  exit 1
fi

mkdir -p part2/results/raw

GAMMAS=(3.5 2.5)
SIZES=(10000 30000 50000 100000 300000 500000 1000000)

# FIX: raised default NRUNS from 2000 -> 5000 so that rare long-lived epidemics
# are properly sampled at large N.
NRUNS=${NRUNS:-5000}

# FIX (gamma=3.5): range is unchanged; the coarse scan already covers the peak
# region (0.05-0.20). Fine-tuning is delegated to the window script.
LMIN_35=${LMIN_35:-0.05}
LMAX_35=${LMAX_35:-0.20}
NLAM_35=${NLAM_35:-25}

# FIX (gamma=2.5): lower bound reduced from 0.005 -> 0.001 so the coarse scan
# captures the tau peak for large N (N>=300k), where lambda_p can fall below 0.005.
LMIN_25=${LMIN_25:-0.001}
LMAX_25=${LMAX_25:-0.08}
NLAM_25=${NLAM_25:-25}

ONLY_GAMMA=${ONLY_GAMMA:-}
ONLY_N=${ONLY_N:-}
DRY_RUN=${DRY_RUN:-0}

printf 'Starting Part 2 scan at %s\n' "$(date)"
printf 'Working directory: %s\n' "$SLURM_SUBMIT_DIR"
printf 'NRUNS=%s\n' "$NRUNS"

for GAMMA in "${GAMMAS[@]}"; do
  if [ -n "$ONLY_GAMMA" ] && [ "$GAMMA" != "$ONLY_GAMMA" ]; then
    continue
  fi

  case "$GAMMA" in
    3.5)
      LMIN="$LMIN_35"
      LMAX="$LMAX_35"
      NLAM="$NLAM_35"
      ;;
    2.5)
      LMIN="$LMIN_25"
      LMAX="$LMAX_25"
      NLAM="$NLAM_25"
      ;;
    *)
      echo "Unsupported GAMMA=$GAMMA"
      exit 1
      ;;
  esac

  for N in "${SIZES[@]}"; do
    if [ -n "$ONLY_N" ] && [ "$N" != "$ONLY_N" ]; then
      continue
    fi

    OUTFILE="part2/results/raw/part2_N${N}_g${GAMMA}.dat"

    if [ -s "$OUTFILE" ]; then
      NLINES=$(wc -l < "$OUTFILE")
      if [ "$NLINES" -gt 1 ]; then
        printf 'Skipping completed case: gamma=%s N=%s (%s lines)\n' "$GAMMA" "$N" "$NLINES"
        continue
      fi
    fi

    CMD=(make run2 N="$N" GAMMA="$GAMMA" NRUNS="$NRUNS" LMIN="$LMIN" LMAX="$LMAX" NLAM="$NLAM" OUT2="$OUTFILE")

    echo
    printf 'Running gamma=%s N=%s range=[%s,%s] nlam=%s\n' "$GAMMA" "$N" "$LMIN" "$LMAX" "$NLAM"
    printf 'Output: %s\n' "$OUTFILE"

    if [ "$DRY_RUN" = "1" ]; then
      printf 'DRY_RUN: %s\n' "${CMD[*]}"
    else
      "${CMD[@]}"
    fi
  done
done

printf '\nFinished Part 2 scan at %s\n' "$(date)"