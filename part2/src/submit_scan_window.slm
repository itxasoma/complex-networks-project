#!/bin/bash
#SBATCH --job-name=part2_window
#SBATCH --partition=std
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=24:00:00
#SBATCH --output=part2/results/logs/part2_window_%j.out
#SBATCH --error=part2/results/logs/part2_window_%j.err

set -euo pipefail

echo "Starting Part 2 refined window scan at $(date)"
echo "Working directory: $(pwd)"

mkdir -p part2/bin part2/results/raw part2/results/processed part2/results/logs part2/figures

# FIX: raised NRUNS from 4000 -> 5000 to match the coarse scan and improve
# sampling of rare long-lived epidemics at large N.
NRUNS=5000
echo "NRUNS=${NRUNS}"

BIN="part2/bin/sis_lifespan_cm"

if [ ! -x "$BIN" ]; then
    echo "Binary not found or not executable: $BIN"
    exit 1
fi

run_case () {
    local N="$1"
    local GAMMA="$2"
    local LMIN="$3"
    local LMAX="$4"
    local NLAM="$5"
    local OUTFILE="$6"

    if [ -f "$OUTFILE" ]; then
        LINES=$(wc -l < "$OUTFILE")
        if [ "$LINES" -ge $((NLAM + 1)) ]; then
            echo "Skipping completed window case: gamma=${GAMMA} N=${N} (${LINES} lines)"
            return
        fi
    fi

    echo
    echo "Running window scan: gamma=${GAMMA} N=${N} range=[${LMIN},${LMAX}] nlam=${NLAM}"
    echo "Output: ${OUTFILE}"
    "$BIN" "$N" "$GAMMA" "$NRUNS" "$LMIN" "$LMAX" "$NLAM" "$OUTFILE"
}

# -------------------------
# gamma = 3.5
# The tau peak sits consistently around lambda ~ 0.095-0.110 across all sizes
# (observed from current data: peaks at 0.125, 0.112, 0.106, 0.112, 0.100, 0.100).
# FIX: widened range to [0.085, 0.120] (was [0.090, 0.110]) and increased nlam
# from 41 -> 36 points at spacing ~0.001 for robust peak detection.
# FIX: added N=100000 window (was missing in original script).
# FIX: added N=1000000 window (coarse scan for N=1M was never run before).
# -------------------------
run_case 100000  3.5 0.085 0.120 36 part2/results/raw/part2_N100000_g3.5_window.dat
run_case 300000  3.5 0.085 0.120 36 part2/results/raw/part2_N300000_g3.5_window.dat
run_case 500000  3.5 0.085 0.120 36 part2/results/raw/part2_N500000_g3.5_window.dat
run_case 1000000 3.5 0.080 0.115 36 part2/results/raw/part2_N1000000_g3.5_window.dat

# -------------------------
# gamma = 2.5
# The tau peak drifts toward lambda=0 as N grows:
#   N=10k:  peak ~ 0.027
#   N=30k:  peak ~ 0.014
#   N=50k:  peak ~ 0.011
#   N>=100k: expected below 0.010 (lambda_c -> 0 for gamma < 3)
# FIX: corrected window ranges to follow the drifting peak downward.
#      Old windows ([0.008, 0.030] for all large N) missed the peak for N>=300k.
# Spacing ~ 0.0005 throughout for adequate resolution.
# -------------------------
run_case 100000  2.5 0.004 0.025 43 part2/results/raw/part2_N100000_g2.5_window.dat
run_case 300000  2.5 0.003 0.018 31 part2/results/raw/part2_N300000_g2.5_window.dat
run_case 500000  2.5 0.002 0.014 25 part2/results/raw/part2_N500000_g2.5_window.dat
run_case 1000000 2.5 0.001 0.010 19 part2/results/raw/part2_N1000000_g2.5_window.dat

echo
echo "Finished refined window scan at $(date)"