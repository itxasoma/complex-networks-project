#!/bin/bash
#SBATCH --job-name=part2_window
#SBATCH --partition=std
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=24:00:00
#SBATCH --output=part2/results/logs/part2_window_%j.out
#SBATCH --error=part2/results/logs/part2_window_%j.err

set -euo pipefail

echo "Starting Part 2 refined window scan at $(date)"
echo "Working directory: $(pwd)"

mkdir -p part2/bin part2/results/raw part2/results/processed part2/results/logs part2/figures

# FIX: raised NRUNS from 4000 -> 5000 to match the coarse scan and improve
# sampling of rare long-lived epidemics at large N.
NRUNS=5000
echo "NRUNS=${NRUNS}"

BIN="part2/bin/sis_lifespan_cm"

if [ ! -x "$BIN" ]; then
    echo "Binary not found or not executable: $BIN"
    exit 1
fi

run_case () {
    local N="$1"
    local GAMMA="$2"
    local LMIN="$3"
    local LMAX="$4"
    local NLAM="$5"
    local OUTFILE="$6"

    if [ -f "$OUTFILE" ]; then
        LINES=$(wc -l < "$OUTFILE")
        if [ "$LINES" -ge $((NLAM + 1)) ]; then
            echo "Skipping completed window case: gamma=${GAMMA} N=${N} (${LINES} lines)"
            return
        fi
    fi

    echo
    echo "Running window scan: gamma=${GAMMA} N=${N} range=[${LMIN},${LMAX}] nlam=${NLAM}"
    echo "Output: ${OUTFILE}"
    "$BIN" "$N" "$GAMMA" "$NRUNS" "$LMIN" "$LMAX" "$NLAM" "$OUTFILE"
}

# -------------------------
# gamma = 3.5
# Peak range observed: ~0.075-0.101 across all sizes.
# FIX: widened range to [0.060, 0.115] and kept nlam=56 (spacing ~0.001).
# FIX: added N=10000, N=30000, N=50000 windows (missing in original script).
# -------------------------
run_case  10000  3.5 0.060 0.115 56 part2/results/raw/part2_N10000_g3.5_window.dat
run_case  30000  3.5 0.060 0.115 56 part2/results/raw/part2_N30000_g3.5_window.dat
run_case  50000  3.5 0.060 0.115 56 part2/results/raw/part2_N50000_g3.5_window.dat
run_case 100000  3.5 0.060 0.115 56 part2/results/raw/part2_N100000_g3.5_window.dat
run_case 300000  3.5 0.060 0.115 56 part2/results/raw/part2_N300000_g3.5_window.dat
run_case 500000  3.5 0.060 0.115 56 part2/results/raw/part2_N500000_g3.5_window.dat
run_case 1000000 3.5 0.060 0.115 56 part2/results/raw/part2_N1000000_g3.5_window.dat


# -------------------------
# gamma = 2.5
# Peak drifts toward lambda=0 as N grows (lambda_c -> 0 for gamma < 3).
# FIX: corrected window ranges to follow the drifting peak downward.
#   N=10k  peak ~ 0.021  -> window [0.005, 0.035]
#   N=30k  peak ~ 0.013  -> window [0.004, 0.025]
#   N=50k  peak ~ 0.011  -> window [0.003, 0.020]
#   N=100k peak ~ 0.008  -> window [0.002, 0.016]
#   N=300k peak < 0.007  -> window [0.001, 0.010]
#   N=500k peak < 0.006  -> window [0.001, 0.008]
#   N=1M   peak < 0.005  -> window [0.001, 0.006]
# FIX: added N=10000, N=30000, N=50000 windows (missing in original script).
# -------------------------
run_case  10000  2.5 0.005 0.035 61 part2/results/raw/part2_N10000_g2.5_window.dat
run_case  30000  2.5 0.004 0.025 43 part2/results/raw/part2_N30000_g2.5_window.dat
run_case  50000  2.5 0.003 0.020 35 part2/results/raw/part2_N50000_g2.5_window.dat
run_case 100000  2.5 0.002 0.016 29 part2/results/raw/part2_N100000_g2.5_window.dat
run_case 300000  2.5 0.001 0.010 19 part2/results/raw/part2_N300000_g2.5_window.dat
run_case 500000  2.5 0.001 0.008 15 part2/results/raw/part2_N500000_g2.5_window.dat
run_case 1000000 2.5 0.001 0.006 11 part2/results/raw/part2_N1000000_g2.5_window.dat


echo
echo "Finished refined window scan at $(date)"